# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ollama LLM & Embeddings Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.2
MAX_TOKENS=1024

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=gastroteacher_knowledge_base
CHUNK_SIZE=500
CHUNK_OVERLAP=100
SIMILARITY_THRESHOLD=0.45
TOP_K_RESULTS=3

# Caching Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
MAX_CACHE_SIZE=500

# Human Escalation Settings
ESCALATION_EMAIL=soporte@gastroteacher.edu.co
ESCALATION_WHATSAPP=+573017325327
ESCALATION_HOURS=Lunes a Viernes 8:00 AM - 6:00 PM (COT)
