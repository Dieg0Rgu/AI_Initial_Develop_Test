# ==========================================
# Gastroteacher - Master .gitignore
# ==========================================

# --- Python & Entornos Virtuales ---
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# Bytecode y Caché de Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Pruebas, Cobertura y Linters
.pytest_cache/
.coverage
.coverage.*
backend/.coverage
htmlcov/
.flake8_cache/
.mypy_cache/
.ruff_cache/

# --- Base de Datos Vectorial y Local ---
backend/data/chroma_db/
data/chroma_db/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.bin

# --- Logs del Sistema ---
*.log
logs/
backend/logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Node.js & Frontend (Vue 3 / Vite) ---
node_modules/
frontend/Rage_frontend/node_modules/
dist/
dist-ssr/
frontend/Rage_frontend/dist/
*.local

# --- Exportaciones y Reportes Temporales ---
exports/
backend/exports/
*.pdf
!backend/data/gastroteacher-logo.png

# --- Variables de Entorno y Secretos ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# --- IDEs y Sistema Operativo ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# macOS
.DS_Store

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini